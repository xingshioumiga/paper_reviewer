@echo off
REM Copy to private/run_my_paper.bat (ASCII only). Double-click runs paper_reviewer from repo root.
REM Optional: set CONDA_EXE_PATH to full path of conda.exe (Scripts\conda.exe, not conda.bat).

setlocal
cd /d "%~dp0\.."

set "CONDA_EXE="
if defined CONDA_EXE_PATH if exist "%CONDA_EXE_PATH%" set "CONDA_EXE=%CONDA_EXE_PATH%"
if not defined CONDA_EXE if exist "%USERPROFILE%\anaconda3\Scripts\conda.exe" set "CONDA_EXE=%USERPROFILE%\anaconda3\Scripts\conda.exe"
if not defined CONDA_EXE if exist "%USERPROFILE%\miniconda3\Scripts\conda.exe" set "CONDA_EXE=%USERPROFILE%\miniconda3\Scripts\conda.exe"
if not defined CONDA_EXE if exist "C:\ProgramData\anaconda3\Scripts\conda.exe" set "CONDA_EXE=C:\ProgramData\anaconda3\Scripts\conda.exe"
if not defined CONDA_EXE (
  where conda >nul 2>&1
  if not errorlevel 1 set "CONDA_EXE=conda"
)
if not defined CONDA_EXE (
  echo ERROR: conda not found. Set CONDA_EXE_PATH or install Anaconda/Miniconda.
  pause
  exit /b 1
)

"%CONDA_EXE%" run -n AIagent1 --no-capture-output python run.py --config private/run_config.yaml
set EXITCODE=%ERRORLEVEL%
if not "%EXITCODE%"=="0" pause
exit /b %EXITCODE%
