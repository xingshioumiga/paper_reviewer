# Python cache and bytecode
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Local-only overrides (never commit API keys)
config/*.private.yaml
# Real per-machine settings (copy from local.example.yaml); may contain API keys and paths
config/local.yaml

# Secrets in environment files
.env
.env.local
.env.*.local

# Windows Explorer duplicate names (often personal drafts / exports)
* - 副本.*

# User manuscript (use sample_manuscript.tex in repo as sample only)
private-draft.tex

# IDE settings (entire folder — never commit machine paths; see contrib/vscode/)
.idea/
.vscode/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs
logs/

# Generated TeX outputs
output.tex
output*.tex
# LaTeX build artifacts (can contain absolute paths)
*.aux
*.log
outputNotes.bib

# OS files
.DS_Store
Thumbs.db
