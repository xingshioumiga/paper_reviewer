# Python cache and bytecode
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Local-only overrides (never commit API keys)
config/*.private.yaml
# Real per-machine settings (copy from local.example.yaml); may contain API keys and paths
config/local.yaml

# Secrets in environment files
.env
.env.local
.env.*.local

# Windows Explorer duplicate names (often personal drafts / exports)
* - 副本.*

# Private LaTeX drafts (add your own patterns; never commit real manuscripts)
*.manuscript.private.tex
draft.local.tex

# IDE settings (entire folder — never commit machine paths; see templates/vscode/)
.idea/
.vscode/

# Local runner only at repo root (anchored /private/; do not use unanchored ``private/``).
/private/

# Local investigation / error reports (not for version control)
local-reports/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs
logs/

# Generated TeX outputs
output.tex
output*.tex
# LaTeX build artifacts (can contain absolute paths)
*.aux
*.log
outputNotes.bib

# OS files
.DS_Store
Thumbs.db

#Cursor history
 .cursorindexingignore

#Reference for Vibe-coding agent
AGENTS.md

#Migration of local warehouse content
APPLY_FOR_COLLABORATOR.md
DELETED_PATHS.txt
FILES_MANIFEST.txt
patches/


#Guidance for  myself
TESTING_GUIDE.md

#Git management tool
scripts/rewrite-history-for-public.ps1

#others
fix_append.py
